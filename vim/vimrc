function! _()

	" dotfiles

	set tags=~/config/vmnom/tags;,tags

	source ~/.config/vim/functions/Plug.vim

	source ~/.config/vim/functions/InspectScheme.vim

	set nowrap
	set cursorline
	set shortmess+=T
	set relativenumber
	set tabstop&
	set cindent&
	set autoindent&
	set smartindent&
	set softtabstop&
	set shiftwidth&
	set expandtab&
	set background=dark

	filetype plugin indent on

	let g:NERDTreeWinSize = 30

	" Toggle NERDTree with Ctrl+e

	nnoremap <C-e> :NERDTreeToggle<CR>

	colorscheme clang

	set errorformat=
				\%f:%l:%c:\ %trror:\ %m,
				\%f:%l:%c:\ %tarning:\ %m,
				\%f:%l:\ %trror:\ %m,
				\%f:%l:\ %tarning:\ %m

	" Open quickfix automatically after :make
	autocmd QuickFixCmdPost make cwindow

	" Highlight errors
	highlight QuickFixLine ctermfg=White ctermbg=DarkRed

endfunction

call _()
