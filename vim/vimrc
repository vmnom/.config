function! _()

	set hidden
	set autoread
	set showtabline=2
	set tabline=%!MyTabLine()

	function! MyTabLine()
		let s = ''
		for i in range(1, tabpagenr('$'))
			let s .= "" vmnom.com/nosql"
		endfor
		let s .= '%#TabLineFill#'
		return s
	endfunction

	" dotfiles

	set tags=~/config/vmnom/tags;,tags

	source ~/.config/vim/functions/Plug.vim

	source ~/.config/vim/functions/InspectScheme.vim

	set nowrap
	set cursorline
	set shortmess+=T
	set relativenumber
	set tabstop&
	set cindent&
	set autoindent&
	set smartindent&
	set softtabstop&
	set shiftwidth&
	set expandtab&
	set background=dark

	filetype plugin indent on

	let g:NERDTreeWinSize = 30

	" Toggle NERDTree with Ctrl+e

	nnoremap <C-e> :NERDTreeToggle<CR>

	colorscheme clang

	set makeprg=make\ -s

	autocmd TabNew * tabclose

endfunction

call _()
