function! _()

	source ~/.config/vim/functions/Plug.vim

	source ~/.config/vim/functions/InspectHL.vim

	"
	" defaults

	set nowrap

	set cursorline

	set relativenumber

	set tabstop&
	set cindent&
	set autoindent&
	set smartindent&
	set softtabstop&
	set shiftwidth&
	set expandtab&

	set background=dark

	"
	" NerdTree
	"

	nnoremap <C-e> :NERDTreeToggle<CR>

	"
	" Syntax
	"

	syntax on

	colorscheme quiet

	augroup clang

		autocmd!

		autocmd FileType cpp syntax keyword Host connection

		autocmd FileType cpp syntax keyword Host playground

		autocmd FileType cpp syntax keyword Host display

		autocmd FileType cpp syntax keyword Host network

		autocmd FileType cpp syntax keyword Host router

		autocmd FileType cpp syntax keyword Host client 

		autocmd FileType cpp syntax keyword Host nosql


		autocmd FileType cpp syntax keyword Group sockaddr_in

		autocmd FileType cpp syntax keyword Group socklen_t

		autocmd FileType cpp syntax keyword Group vector

		autocmd FileType cpp syntax keyword Group void

		autocmd FileType cpp syntax keyword Group int


		autocmd FileType cpp syntax keyword Struct struct

		autocmd FileType cpp syntax keyword Constant HTTP

	augroup END

	"
	" default

	hi Normal ctermfg=8 ctermbg=233 cterm=none

	hi Comment ctermfg=239 cterm=none

	"
	" apply

	hi Type ctermfg=8 cterm=none

	hi cUserFunction ctermfg=220 cterm=none

	hi Statement ctermfg=9

	hi link Group Type
	hi link Struct Type
	hi link cRepeat Type
	hi link cStatement Type

	"
	" primary

	hi Constant ctermfg=60

	hi link Host Constant

	"
	" others

	hi Directory ctermfg=8 cterm=bold

	hi link NERDTreeFile Type 

	hi LineNr ctermfg=8

	hi PreProc ctermfg=8

	hi Special ctermfg=8

	hi Identifier ctermfg=190

	"
	" optional

	hi CursorLine ctermbg=234

	hi CursorLineNr ctermbg=236 ctermfg=9

	hi NERDTreeDirSlash ctermfg=188

	hi NERDTreeCursorLine guibg=Red guifg=NONE gui=NONE

endfunction

call _()
