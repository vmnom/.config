function! _()

	" dotfiles

	set tags=~/config/vmnom/tags;,tags

	source ~/.config/vim/functions/Plug.vim

	source ~/.config/vim/functions/InspectScheme.vim

	set nowrap
	set cursorline
	set shortmess+=T
	set relativenumber
	set tabstop&
	set cindent&
	set autoindent&
	set smartindent&
	set softtabstop&
	set shiftwidth&
	set expandtab&
	set background=dark

	filetype plugin indent on

	let g:NERDTreeWinSize = 38

	" Toggle NERDTree with Ctrl+e

	nnoremap <C-e> :source ~/.config/vim/vimrc<CR>:NERDTreeToggle<CR>

	colorscheme clang

endfunction

call _()


