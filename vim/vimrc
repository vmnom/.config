function! _()

	let g:NERDTreeDirSlash = ''

	source ~/.config/vim/functions/Plug.vim
	source ~/.config/vim/functions/InspectHL.vim

	set nowrap
	set cursorline
	set shortmess+=T
	set relativenumber
	set tabstop&
	set cindent&
	set autoindent&
	set smartindent&
	set softtabstop&
	set shiftwidth&
	set expandtab&
	set background=dark
	nnoremap <C-e> :NERDTreeToggle<CR>
	colorscheme clang

endfunction

call _()
